# Copiar a .env y ajustar. .env NO se sube al repositorio.

ENV=dev

# --- PostgreSQL ---
POSTGRES_USER=barmoe
POSTGRES_PASSWORD=barmoe

# --- JWT ---
# Para un secreto real: openssl rand -hex 32
JWT_SECRET=cambiar-este-secreto-en-produccion

# --- Requisitos no funcionales del tablero ---
INACTIVIDAD_SEGUNDOS=180     # RNF-03 · 3 minutos
MAX_INTENTOS_LOGIN=3         # RNF-09 · bloqueo por reintentos
PERMITIR_MULTISESION=false   # RNF-10 · sesión única

# --- Administrador inicial (cambiar antes de cualquier demo) ---
ADMIN_USUARIO=admin
ADMIN_PASSWORD=Admin2026

# --- CORS ---
ORIGENES_PERMITIDOS=http://localhost:5173,http://localhost:3000
